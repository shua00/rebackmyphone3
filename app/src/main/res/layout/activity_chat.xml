<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1f2937"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📟 局域网对讲机"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center_vertical"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnChatSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:text="设置"
            android:textSize="13sp"
            android:backgroundTint="#374151"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 用 RelativeLayout 包裹，为了放置悬浮标签 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <TextView
                android:id="@+id/chatText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#333333"
                android:lineSpacingExtra="8dp" />
        </ScrollView>

        <!-- 新消息悬浮标签 -->
        <TextView
            android:id="@+id/tvNewMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="16dp"
            android:background="#E624292F"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="↓ 新消息"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvDeliveryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#EEF2F7"
        android:textColor="#374151"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <EditText
            android:id="@+id/inputMsg"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:hint="输入消息发到局域网..."
            android:background="#F0F0F0"
            android:padding="8dp"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="1"
            android:maxLines="5"
            android:gravity="center_vertical|start"
            android:scrollbars="vertical"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/btnTransfer"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="附件"
            android:textSize="12sp"
            android:padding="0dp"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginStart="6dp"
            android:backgroundTint="#475569"
            android:textColor="#FFFFFF"
            android:focusable="false"
            android:focusableInTouchMode="false" />
        <Button
            android:id="@+id/btnSend"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="发送"
            android:textSize="13sp"
            android:padding="0dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1f2937"
            android:textColor="#FFFFFF"
            android:focusable="false"
            android:focusableInTouchMode="false" />
    </LinearLayout>
</LinearLayout>
